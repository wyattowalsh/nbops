# Runtime settings for nbops (prefix NBOPS_).
# Copy to `.env` in the working directory if you use direnv or local overrides.
# Process environment variables always win over the file.

# Loguru level: DEBUG, INFO, WARNING, ERROR
NBOPS_LOG_LEVEL=INFO

# Lint budget for code-cell output size (NB006)
NBOPS_MAX_OUTPUT_CHARS=100000

# Default nbclient timeout in seconds (`nbops[execute]`)
NBOPS_EXECUTE_TIMEOUT=120

# Show tqdm progress for directory batch operations when stderr is a TTY
NBOPS_PROGRESS=true
