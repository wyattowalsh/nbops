{
  "name": "nbops",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "user": "ubuntu",
  "install": "uv sync --frozen",
  "terminals": [
    {
      "name": "api",
      "command": "uv run uvicorn nbops.api:app --host 0.0.0.0 --port 8000",
      "description": "nbops FastAPI dev server on http://0.0.0.0:8000 (docs at /docs)."
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ]
}
